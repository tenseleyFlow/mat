#!/bin/sh
# configure — feature detection for mat.
#
# Writes config.mk (consumed by the Makefile) and src/config_generated.h
# (included by compat.h). Sprint 00 establishes the probe machinery; the
# syscall capability probes (copy_file_range, splice, ...) are wired in but
# only matter once Sprint 01 uses them. POSIX sh only.

set -u

CC=${CC:-cc}
PREFIX=${PREFIX:-/usr/local}
VERSION=$(cat VERSION 2>/dev/null || echo "0.0.0-dev")
GIT_HASH=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
EXTRA_CFLAGS=${CFLAGS:-}
WERROR=1

for arg in "$@"; do
    case "$arg" in
        --prefix=*) PREFIX=${arg#--prefix=} ;;
        --cc=*)     CC=${arg#--cc=} ;;
        --no-werror) WERROR=0 ;;
        --help)
            cat <<EOF
Usage: ./configure [options]
  --prefix=DIR   install prefix (default: /usr/local)
  --cc=CC        C compiler (default: \$CC or cc)
  --no-werror    do not treat warnings as errors
EOF
            exit 0 ;;
        *) echo "configure: unknown option: $arg" >&2; exit 1 ;;
    esac
done

# Must end in .c so the compiler recognizes it as C source.
tmpc="${TMPDIR:-/tmp}/mat_conf_$$.c"
trap 'rm -f "$tmpc" "$tmpc.out"' EXIT INT TERM

# probe NAME 'snippet' -> echoes "#define HAVE_NAME 1" on success.
probe() {
    name=$1
    code=$2
    printf '%s\n' "$code" > "$tmpc"
    if $CC $EXTRA_CFLAGS -o "$tmpc.out" "$tmpc" >/dev/null 2>&1; then
        echo "#define HAVE_$name 1"
        echo "  probe $name: yes" >&2
    else
        echo "  probe $name: no" >&2
    fi
}

# Verify the compiler works at all.
printf 'int main(void){return 0;}\n' > "$tmpc"
if ! $CC -std=c11 -o "$tmpc.out" "$tmpc" >/dev/null 2>&1; then
    echo "configure: error: '$CC' cannot compile a C11 program" >&2
    exit 1
fi
# Feature-test macro so POSIX/extension symbols are visible under -std=c11.
# glibc hides them in strict ISO mode; _GNU_SOURCE also exposes copy_file_range
# and splice (needed from Sprint 01). BSDs expose everything by default.
OS=$(uname -s 2>/dev/null || echo unknown)
case "$OS" in
    Linux)  FEATURE_CFLAGS="-D_GNU_SOURCE" ;;
    Darwin) FEATURE_CFLAGS="-D_DARWIN_C_SOURCE" ;;
    *)      FEATURE_CFLAGS="" ;;
esac

echo "configure: using CC=$CC, OS=$OS, PREFIX=$PREFIX, version $VERSION" >&2
echo "configure: running probes..." >&2

# --- generate src/config_generated.h ---
{
    echo "/* Generated by ./configure — do not edit. */"
    echo "#ifndef MAT_CONFIG_GENERATED_H"
    echo "#define MAT_CONFIG_GENERATED_H"
    echo "#define MAT_VERSION \"$VERSION ($GIT_HASH)\""
    probe COPY_FILE_RANGE '#define _GNU_SOURCE
#include <unistd.h>
int main(void){ return (int)copy_file_range(0,0,1,0,0,0); }'
    probe SPLICE '#define _GNU_SOURCE
#include <fcntl.h>
int main(void){ return (int)splice(0,0,1,0,0,0); }'
    probe SENDFILE '#include <sys/types.h>
#include <sys/socket.h>
#include <sys/uio.h>
int main(void){ return 0; }'
    probe POSIX_FADVISE '#include <fcntl.h>
int main(void){ return posix_fadvise(0,0,0,POSIX_FADV_SEQUENTIAL); }'
    probe VMSPLICE '#define _GNU_SOURCE
#include <fcntl.h>
#include <sys/uio.h>
int main(void){ struct iovec v={0,0}; return (int)vmsplice(1,&v,1,0); }'
    echo "#endif /* MAT_CONFIG_GENERATED_H */"
} > src/config_generated.h

# --- generate config.mk ---
WERROR_FLAG=""
[ "$WERROR" = "1" ] && WERROR_FLAG="-Werror"
{
    echo "# Generated by ./configure — do not edit."
    echo "CC = $CC"
    echo "PREFIX = $PREFIX"
    echo "VERSION = $VERSION"
    echo "WARNFLAGS = -Wall -Wextra -Wshadow -Wconversion $WERROR_FLAG"
    echo "FEATURE_CFLAGS = $FEATURE_CFLAGS"
    echo "CONF_CFLAGS = -std=c11 -O2 $EXTRA_CFLAGS"
} > config.mk

echo "configure: wrote config.mk and src/config_generated.h" >&2
